soong_namespace {
}

// The stock-identical VNDK snapshot retains the BSP's GraphicsCommon V4
// contract. Current source consumers continue using their own gralloc types.
cc_prebuilt_library_shared {
    name: "libgralloctypes_vendorcompat",
    stem: "libgralloctypes",
    srcs: [":libgralloctypes.vndk.34.arm64"],
    compile_multilib: "64",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "android.hardware.graphics.common-V4-ndk",
        "android.hardware.graphics.mapper@4.0",
        "libhidlbase",
        "liblog",
        "libc++",
    ],
}

// The pinned arm64 VNDK 34 snapshot is byte-identical to stock's VNDK APEX.
// Source consumers retain the current foundation library; BSP clients use this
// original API 34 implementation without importing current AV header types.
cc_prebuilt_library_shared {
    name: "libstagefright_foundation_vendorcompat",
    stem: "libstagefright_foundation",
    srcs: [":libstagefright_foundation.vndk.34.arm64"],
    compile_multilib: "64",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
        "libc++",
    ],
}

// Stock-identical API 34 snapshot; preserve the original BSP dependency contract.
cc_prebuilt_library_shared {
    name: "android.hardware.graphics.allocator-V2-ndk_vendorcompat",
    stem: "android.hardware.graphics.allocator-V2-ndk",
    srcs: [":android.hardware.graphics.allocator-V2-ndk.vndk.34.arm64"],
    compile_multilib: "64",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "libbinder_ndk",
        "android.hardware.common-V2-ndk",
        "android.hardware.graphics.common-V4-ndk",
        "libc++",
    ],
}

// Stock-identical API 34 snapshot; preserve the original BSP dependency contract.
cc_prebuilt_library_shared {
    name: "libui_vendorcompat",
    stem: "libui",
    srcs: [":libui.vndk.34.arm64"],
    compile_multilib: "64",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "android.hardware.graphics.common-V4-ndk",
        "android.hardware.graphics.allocator-V2-ndk_vendorcompat",
        "android.hardware.graphics.allocator@2.0",
        "android.hardware.graphics.allocator@3.0",
        "android.hardware.graphics.allocator@4.0",
        "android.hardware.graphics.common@1.2",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@2.1",
        "android.hardware.graphics.mapper@3.0",
        "android.hardware.graphics.mapper@4.0",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libgralloctypes_vendorcompat",
        "libhidlbase",
        "libsync",
        "libutils",
        "liblog",
        "libvndksupport",
        "libc++",
    ],
}

// The BSP helper is byte-identical to the pinned VNDK 34 snapshot.
cc_prebuilt_library_shared {
    name: "libstagefright_bufferqueue_helper_vendorcompat",
    stem: "libstagefright_bufferqueue_helper",
    srcs: [":libstagefright_bufferqueue_helper.vndk.34.arm64"],
    compile_multilib: "64",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "libbase",
        "libcutils",
        "libhidlbase",
        "libhidlmemory",
        "liblog",
        "libstagefright_foundation_vendorcompat",
        "libui_vendorcompat",
        "libutils",
        "android.hardware.graphics.bufferqueue@1.0",
        "android.hardware.graphics.bufferqueue@2.0",
        "android.hidl.token@1.0-utils",
        "libEGL",
        "libnativewindow",
        "libvndksupport",
        "libc++",
    ],
}
