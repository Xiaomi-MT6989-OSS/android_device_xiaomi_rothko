soong_namespace {
}

// The stock-identical VNDK snapshot retains the BSP's GraphicsCommon V4
// contract. Current source consumers continue using their own gralloc types.
cc_prebuilt_library_shared {
    name: "libgralloctypes_vendorcompat",
    stem: "libgralloctypes",
    srcs: [":libgralloctypes.vndk.34.arm64"],
    compile_multilib: "64",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "android.hardware.graphics.common-V4-ndk",
        "android.hardware.graphics.mapper@4.0",
        "libhidlbase",
        "liblog",
        "libc++",
    ],
}

// Stock-identical API 34 snapshot; preserve the original BSP dependency contract.
cc_prebuilt_library_shared {
    name: "android.hardware.graphics.allocator-V2-ndk_vendorcompat",
    stem: "android.hardware.graphics.allocator-V2-ndk",
    srcs: [":android.hardware.graphics.allocator-V2-ndk.vndk.34.arm64"],
    compile_multilib: "64",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "libbinder_ndk",
        "android.hardware.common-V2-ndk",
        "android.hardware.graphics.common-V4-ndk",
        "libc++",
    ],
}

// Stock-identical API 34 snapshot; preserve the original BSP dependency contract.
cc_prebuilt_library_shared {
    name: "libui_vendorcompat",
    stem: "libui",
    srcs: [":libui.vndk.34.arm64"],
    compile_multilib: "64",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "android.hardware.graphics.common-V4-ndk",
        "android.hardware.graphics.allocator-V2-ndk_vendorcompat",
        "android.hardware.graphics.allocator@2.0",
        "android.hardware.graphics.allocator@3.0",
        "android.hardware.graphics.allocator@4.0",
        "android.hardware.graphics.common@1.2",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@2.1",
        "android.hardware.graphics.mapper@3.0",
        "android.hardware.graphics.mapper@4.0",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libgralloctypes_vendorcompat",
        "libhidlbase",
        "libsync",
        "libutils",
        "liblog",
        "libvndksupport",
        "libc++",
    ],
}
