soong_namespace {
    // The device colour controller links the byte-identical stock DisplayFeature
    // V2 binding, which is declared in the generated vendor blob namespace.
    imports: [
        "vendor/xiaomi/rothko",
    ],
}

// The source is generated as a filegroup by extract-utils from the original
// vendor manifest. Preserve the existing Soong VINTF processing on regeneration.
vintf_fragment {
    name: "nfc-service-tms.xml",
    src: ":rothko_tms_nfc_manifest",
    vendor: true,
}
