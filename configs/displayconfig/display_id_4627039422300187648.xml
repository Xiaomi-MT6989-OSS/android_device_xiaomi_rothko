<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<displayConfiguration>
    <!-- Stock nits/backlight calibration is linear in the shipped DDC implementation.
         A16 needs the explicit interpolation attribute to preserve those segments. -->
    <screenBrightnessMap interpolation="linear">
        <point>
            <value>0.000854597</value>
            <nits>2.0</nits>
        </point>
        <point>
            <value>0.499938</value>
            <nits>500.0</nits>
        </point>
        <point>
            <value>0.699914540</value>
            <nits>700.0</nits>
        </point>
        <point>
            <value>0.952386766</value>
            <nits>1600.0</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>4500.0</nits>
        </point>
    </screenBrightnessMap>
    <!-- Stock sunlight admission and ratio map. A16 HdrBrightnessData derives its
         standard HDR fallback from this node; keep upstream transition animation.
         The device policy independently limits ordinary SDR/HDR and conditional peak. -->
    <highBrightnessMode enabled="true">
        <!-- Transition point brightness from normal to HBM mode -->
        <transitionPoint>0.499938</transitionPoint>
        <!-- Minimum lux to enter HBM -->
        <minimumLux>6001</minimumLux>
        <!-- Time limitation for HBM-->
        <timing>
            <timeWindowSecs>0</timeWindowSecs>
            <timeMaxSecs>0</timeMaxSecs>
            <timeMinSecs>0</timeMinSecs>
        </timing>
        <!-- A16 does not consume stock thermalStatusLimit. The stock device policy
             applies board-temperature/safety nits bounds to SDR and HDR instead. -->
        <!-- Low power mode limitation for HBM -->
        <allowInLowPowerMode>true</allowInLowPowerMode>
        <minimumHdrPercentOfScreen>0</minimumHdrPercentOfScreen>
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>8.0</hdrRatio>
            </point>
            <point>
                <sdrNits>1200.0</sdrNits>
                <hdrRatio>8.0</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>
    <ambientLightHorizonLong>1500</ambientLightHorizonLong>
    <ambientLightHorizonShort>1000</ambientLightHorizonShort>
</displayConfiguration>