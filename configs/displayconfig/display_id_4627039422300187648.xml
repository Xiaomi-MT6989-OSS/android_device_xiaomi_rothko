<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<displayConfiguration>
    <!-- Stock createBacklightConversionSplines uses linear nits/backlight splines even when
         the XML omits interpolation. A16 needs this attribute to preserve that behavior. -->
    <screenBrightnessMap interpolation="linear">
        <point>
            <value>0.000854597</value>
            <nits>2.0</nits>
        </point>
        <point>
            <value>0.499938</value>
            <nits>500.0</nits>
        </point>
        <point>
            <value>0.699914540</value>
            <nits>700.0</nits>
        </point>
        <point>
            <value>0.952386766</value>
            <nits>1600.0</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>4500.0</nits>
        </point>
    </screenBrightnessMap>
    <!-- OS3.0.307.0 calibration is preserved above. The brightness resource raw maximum
         is capped at the stock normal/HBM boundary 0.499938 (500 calibrated nits).
         Do not restore the old HBM node: its transition would equal that raw maximum.
         Higher calibration points are not reachable until OEM high-brightness thermal
         policy has been restored and validated. -->
    <hdrBrightnessConfig>
        <!-- No additional lux-dependent cap within the already bounded normal range. -->
        <brightnessMap>
            <point><first>0</first><second>1</second></point>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>0</brightnessIncreaseDebounceMillis>
        <brightnessDecreaseDebounceMillis>0</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampIncrease>0.415903</screenBrightnessRampIncrease>
        <screenBrightnessRampDecrease>0.415903</screenBrightnessRampDecrease>
        <minimumHdrPercentOfScreenForNbm>0</minimumHdrPercentOfScreenForNbm>
        <minimumHdrPercentOfScreenForHbm>0</minimumHdrPercentOfScreenForHbm>
        <allowInLowPowerMode>false</allowInLowPowerMode>
        <!-- Original rothko ratio ceiling, still limited by the content's desired ratio. -->
        <sdrHdrRatioMap>
            <point><first>2.0</first><second>8.0</second></point>
            <point><first>1200.0</first><second>8.0</second></point>
        </sdrHdrRatioMap>
    </hdrBrightnessConfig>
    <ambientLightHorizonLong>1500</ambientLightHorizonLong>
    <ambientLightHorizonShort>1000</ambientLightHorizonShort>
</displayConfiguration>
