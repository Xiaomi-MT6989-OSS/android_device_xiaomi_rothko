# SPDX-License-Identifier: Apache-2.0
# The kernel advertises DEVNAME=mi_display/disp_feature. Keep the original
# subsystem naming, granting only the stock service's UID/groups access.
subsystem mi_display
    devname uevent_devpath
    dirname /dev/mi_display

/dev/mi_display/disp_feature 0660 system graphics

# Match the stock service UID while limiting access to its system group.
/dev/vis_display_spidev 0660 system system
