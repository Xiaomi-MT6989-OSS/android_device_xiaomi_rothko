# SPDX-License-Identifier: Apache-2.0
# Preserve the original AIDL executable, UID and graphics group. The device
# colour controller owns the only channel to this service, so it must be
# running before Settings can list or apply a colour profile.
# The legacy DisplayFeatureControl wrapper is not part of this candidate.
service vendor.displayfeatureaidl-hal /vendor/bin/hw/vendor.xiaomi.hardware.displayfeature_aidl-service
    class hal
    user system
    group system graphics

on early-boot
    chown system system /sys/class/mi_display/disp-DSI-0/disp_count
    chmod 0664 /sys/class/mi_display/disp-DSI-0/disp_count
    chown system system /sys/class/mi_display/disp-DSI-0/brightness_clone
    chmod 0664 /sys/class/mi_display/disp-DSI-0/brightness_clone

on post-fs-data
    restorecon_recursive /data/vendor/display
