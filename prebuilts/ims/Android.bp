// SPDX-License-Identifier: Apache-2.0

// Stock MediaTek IMS, framework, VT service and their reviewed native closure.
// The APK is re-signed with the platform key below; it must share the
// android.uid.phone signature with TeleService.

android_app_import {
    name: "ImsService",
    apk: "ImsService.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    filename: "ImsService.apk",
}
java_import {
    name: "mediatek-ims-base",
    jars: ["mediatek-ims-base.jar"],
    installable: true,
    system_ext_specific: true,
}

java_import {
    name: "mediatek-ims-common",
    jars: ["mediatek-ims-common.jar"],
    installable: true,
    system_ext_specific: true,
}

cc_prebuilt_binary {
    name: "vtservice",
    owner: "xiaomi",
    system_ext_specific: true,
    compile_multilib: "64",
    strip: {
        none: true,
    },
    shared_libs: [
        "libbinder",
        "libutils",
        "libcutils",
        "liblog",
        "libmtk_vt_service",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    target: {
        android_arm64: {
            srcs: ["bin/vtservice"],
        },
    },
}

