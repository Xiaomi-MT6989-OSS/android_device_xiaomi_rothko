// SPDX-License-Identifier: Apache-2.0

// The stock MTK BluetoothAudioProvider publishes session state through the
// `_mtk` session library. The A16 source-built module uses the generic session
// library, so its readiness check can never observe the provider's session.
// Keep this device-specific module paired with the stock provider.
cc_prebuilt_library_shared {
    name: "audio.bluetooth.default.rothko",
    stem: "audio.bluetooth.default",
    owner: "xiaomi",
    vendor: true,
    relative_install_path: "hw",
    overrides: ["audio.bluetooth.default"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    shared_libs: [
        "android.hardware.bluetooth.audio-V3-ndk_vendorcompat",
        "libbluetooth_audio_session_aidl_mtk",
        "libbluetooth_audio_session.rothko",
        "android.hardware.bluetooth.audio@2.0",
        "android.hardware.bluetooth.audio@2.1",
        "libaudioutils",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libfmq",
        "liblog",
        "libutils",
        "libhidlbase",
    ],
    target: {
        android_arm64: {
            srcs: ["audio.bluetooth.default.so"],
        },
    },
}

// Preserve the stock legacy bridge without replacing the platform session libraries.
cc_prebuilt_library_shared {
    name: "libbluetooth_audio_session.rothko",
    stem: "libbluetooth_audio_session-rothko",
    owner: "xiaomi",
    vendor: true,
    compile_multilib: "64",
    strip: { none: true },
    srcs: ["libbluetooth_audio_session-rothko.so"],
    shared_libs: [
        "android.hardware.audio.common@5.0",
        "android.hardware.bluetooth.audio@2.0",
        "android.hardware.bluetooth.audio@2.1",
        "libbluetooth_audio_session_aidl_mtk",
        "libbase",
        "libcutils",
        "libfmq",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
}
