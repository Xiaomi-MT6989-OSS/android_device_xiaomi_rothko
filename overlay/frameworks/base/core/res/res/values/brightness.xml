<?xml version="1.0" encoding="utf-8"?>
<!-- OS3.0.307.0 stock calibration, converted where A16 uses logical brightness. -->
<resources>
    <!-- Factory board-temperature and safety-nits bounds apply to both SDR and HDR.
         Gallery's separate 37/35 C gate is for its explicit OEM boost request. -->
    <string name="config_deviceSpecificBrightnessPolicy" translatable="false">org.lineageos.rothko.brightness.RothkoBrightnessPolicy</string>
    <bool name="config_automatic_brightness_available">true</bool>
    <item name="config_screenBrightnessSettingMinimumFloat" type="dimen" format="float">0.000854597</item>
    <!-- DDC normalizes raw [min,max] to logical [0,1]. Stock dim/default are raw
         0.000854597 / 0.0749603; (raw-min)/(max-min) preserves their HAL input.
         Recalculate these two values whenever the raw bounds change. PMS and DDC
         both consume these resources, so keep the conversion here, not in one loader. -->
    <item name="config_screenBrightnessDimFloat" type="dimen" format="float">0.0</item>
    <item name="config_screenBrightnessSettingDefaultFloat" type="dimen" format="float">0.1484836</item>
    <!-- AOSP interprets min/max as HAL raw backlight bounds, then normalizes UI 0..1.
         Limit HDR/automatic brightness to the stock normal range until OEM HBM thermal
         policy is restored and validated. -->
    <item name="config_screenBrightnessSettingMaximumFloat" type="dimen" format="float">0.499938</item>
    <!-- Previous project releases normalized this raw range to logical 0..1. Persist the
         domain with user brightness values before expanding it; new installs stay unset. -->
    <item name="config_screenBrightnessLegacyBacklightMinimumFloat" type="dimen" format="float">0.000854597</item>
    <item name="config_screenBrightnessLegacyBacklightMaximumFloat" type="dimen" format="float">0.499938</item>
    <!-- Keep per-user raw-domain settings; do not restore a shared foldable-display nits value. -->
    <bool name="config_persistBrightnessNitsForDefaultDisplay">false</bool>
    <item name="config_brightnessRampRateFast" type="dimen" format="float">0.415903</item>
    <integer name="config_autoBrightnessBrighteningLightDebounce">1000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">1000</integer>
