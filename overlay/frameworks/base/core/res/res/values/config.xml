<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="config_deviceSpecificSystemServices" translatable="false">
        <item>org.lineageos.rothko.fingerprint.RothkoFodService</item>
    </string-array>
    <!-- Reuse the platform controls for optical keyguard unlock while the panel is off. -->
    <bool name="config_screen_off_udfps_enabled">true</bool>
    <bool name="config_screen_off_udfps_default_on">true</bool>
    <!-- Power HAL delegates mode 14 to the stock touchfeature service. -->
    <bool name="config_supportDoubleTapWake">true</bool>
    <string name="config_dozeUdfpsLongPressSensorType" translatable="false">org.lineageos.sensor.udfps</string>
    <!-- Use the standard doze service for the stock OLED AOD path; AOD remains a user preference. -->
    <string name="config_dozeComponent" translatable="false">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
    <!-- Native 60/90/120/144 Hz modes were verified on rothko with HWC.
         Let the user's peak setting cap rendering instead of a default 60 Hz vote. -->
    <integer name="config_defaultRefreshRate">0</integer>
    <integer name="config_defaultPeakRefreshRate">144</integer>
    <!-- Stock rothko enables software navigation; SystemUI needs it for edge back. -->
    <bool name="config_showNavigationBar">true</bool>
</resources>
