<resources>
    <!-- Use the platform WifiDisplayAdapter / RemoteDisplay source, not a debug
         property. Rothko provides STA+P2P, AVC encoding and remote-submix audio. -->
    <bool name="config_enableWifiDisplay">true</bool>
    <!-- The stock MTK HDCP helper does not implement the platform HDCP plugin
         ABI. Do not advertise protected-buffer capture without that bridge. -->
    <bool name="config_wifiDisplaySupportsProtectedBuffers">false</bool>
</resources>
