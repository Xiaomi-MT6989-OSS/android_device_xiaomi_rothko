<resources>
    <!-- These framework providers supply location to system features before Google
         setup and when Google network positioning is unavailable. -->
    <bool name="config_enableNetworkLocationOverlay" translatable="false">false</bool>
    <string name="config_networkLocationProviderPackageName" translatable="false">com.xiaomi.metoknlp</string>
    <bool name="config_enableFusedLocationOverlay" translatable="false">false</bool>
    <string name="config_fusedLocationProviderPackageName" translatable="false">com.android.location.fused</string>

    <!-- Let the standard permission policy initialize the shipped providers. -->
    <string-array name="config_locationProviderPackageNames" translatable="false">
        <item>com.android.location.fused</item>
        <item>com.xiaomi.metoknlp</item>
    </string-array>
</resources>
