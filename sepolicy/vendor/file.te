type vendor_camera_runtime_data_file, file_type, data_file_type;

# Separate original display nodes and generated runtime state from calibration.
type sysfs_displayfeature, fs_type, sysfs_type;
type sysfs_displayfeature_control, fs_type, sysfs_type;
type vendor_display_runtime_data_file, file_type, data_file_type;

