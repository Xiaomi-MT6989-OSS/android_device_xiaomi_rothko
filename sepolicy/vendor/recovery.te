# SPDX-License-Identifier: Apache-2.0
# Recovery runs the same stock THP main without its normal-system binder HAL.
# No permissions are added to normal-system Recovery policy.
recovery_only(`
    # init waits for the THP node only needs to stat the device.
    allow init touchfeature_device:chr_file getattr;
    allow recovery self:global_capability_class_set sys_nice;
    allow recovery touchfeature_device:chr_file rw_file_perms;
    allow recovery input_device:chr_file rw_file_perms;
    allow recovery uhid_device:chr_file rw_file_perms;
    r_dir_file(recovery, sysfs_touch_hostprocess)
    allow recovery sysfs_touch_hostprocess:file w_file_perms;
    r_dir_file(recovery, sysfs_touch_suspend)
    allow recovery sysfs_touch_suspend:file w_file_perms;
    allow recovery proc_tp_file:file rw_file_perms;
    r_dir_file(recovery, sysfs_therm)
')
