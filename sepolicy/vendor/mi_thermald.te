# SPDX-License-Identifier: Apache-2.0

type mi_thermald, domain;
type mi_thermald_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mi_thermald)

# The original Xiaomi thermal daemon owns the charging current and thermal
# policy. Grant only the battery, thermal, CPU and persisted thermal paths it
# uses; this does not grant generic sysfs or device access.
allow mi_thermald self:capability { chown fowner fsetid sys_boot };
allow mi_thermald self:capability2 { wake_alarm block_suspend };

allow mi_thermald sysfs:dir r_dir_perms;
allow mi_thermald sysfs_power:dir r_dir_perms;
allow mi_thermald sysfs_batteryinfo:dir r_dir_perms;
allow mi_thermald sysfs_batteryinfo:file rw_file_perms;
allow mi_thermald sysfs_batteryinfo:lnk_file r_file_perms;

allow mi_thermald sysfs_therm:dir r_dir_perms;
allow mi_thermald sysfs_therm:file rw_file_perms;
allow mi_thermald sysfs_therm:lnk_file r_file_perms;

allow mi_thermald sysfs_devices_system_cpu:dir r_dir_perms;
allow mi_thermald sysfs_devices_system_cpu:file rw_file_perms;
allow mi_thermald sysfs_leds:dir r_dir_perms;
allow mi_thermald sysfs_leds:file r_file_perms;

allow mi_thermald thermal_core_data_file:dir rw_dir_perms;
allow mi_thermald thermal_core_data_file:file create_file_perms;

get_prop(mi_thermald, vendor_thermal_prop)
set_prop(mi_thermald, vendor_thermal_prop)
