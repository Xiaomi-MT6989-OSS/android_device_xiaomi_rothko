# Boot-time denials observed on stock vendor domains. Each rule grants the
# smallest permission that satisfies the observed access.

# The stock audio HAL inspects /sys/class/thermal while it starts.
r_dir_file(hal_audio_default, sysfs_therm)

# The stock touch HAL reads the default property area directly. That access is
# covered by a platform neverallow (property isolation), so it stays denied:
# the HAL only loses a boot-time read it does not depend on.
