# Boot-time denials observed on stock vendor domains. Each rule grants the
# smallest permission that satisfies the observed access.

# The stock audio HAL inspects /sys/class/thermal while it starts.
r_dir_file(hal_audio_default, sysfs_therm)

# Stock vendor_sepolicy grants mtk_hal_camera sysfs_therm dir search and file
# read/write. The camera HAL uses it while adapting capture to thermal state;
# without it real camera use logs avc denied search on /sys/class/thermal.
r_dir_file(mtk_hal_camera, sysfs_therm)

# Stock vendor_sepolicy grants mtk_hal_camera read on proc_pressure_mem
# (serialized as proc_pressure_mem_34_0). The camera algorithm framework
# reads /proc/pressure/memory when a session starts; without it every start
# logs "failed open file path:/proc/pressure/memory".
allow mtk_hal_camera proc_pressure_mem:file r_file_perms;

# The stock touch HAL reads the default property area directly. That access is
# covered by a platform neverallow (property isolation), so it stays denied:
# the HAL only loses a boot-time read it does not depend on.
