# SPDX-License-Identifier: Apache-2.0

type batterysecret, domain;
type batterysecret_exec, exec_type, vendor_file_type, file_type;
type sysfs_usbpd_device, fs_type, sysfs_type;

init_daemon_domain(batterysecret)

# The stock PD authentication daemon runs as root and needs the uevent socket
# plus the actual rothko PD and battery power-supply nodes. Vendor VDM commands
# are performed through /sys/class/Charging_Adapter/pd_adapter.
allow batterysecret self:capability { sys_boot sys_tty_config };
allow batterysecret self:capability2 block_suspend;
allow batterysecret self:netlink_kobject_uevent_socket {
    create bind getopt setopt read
};

# Traverse sysfs to reach the otherwise narrowly typed power nodes.
allow batterysecret sysfs:dir r_dir_perms;
allow batterysecret sysfs_batteryinfo:dir r_dir_perms;
allow batterysecret sysfs_batteryinfo:file rw_file_perms;
allow batterysecret sysfs_batteryinfo:lnk_file r_file_perms;
allow batterysecret sysfs_usbpd_device:dir r_dir_perms;
allow batterysecret sysfs_usbpd_device:file rw_file_perms;
allow batterysecret sysfs_wake_lock:file rw_file_perms;
allow batterysecret kmsg_device:chr_file rw_file_perms;

get_prop(batterysecret, vendor_default_prop)
