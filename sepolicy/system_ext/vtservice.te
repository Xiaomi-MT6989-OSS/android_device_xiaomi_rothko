# SPDX-License-Identifier: Apache-2.0

# The MTK base policy already declares the vtservice domain, executable and
# media.VTS service. Add only the missing runtime permissions used by the
# stock executable and the IMS video-telephony callback path.
hwbinder_use(vtservice)
allow vtservice { untrusted_app untrusted_app_32 }:binder call;

# The stock init declaration requests NET_ADMIN, NET_RAW and an RT ioprio.
allow vtservice self:global_capability_class_set { net_admin net_raw sys_nice };
