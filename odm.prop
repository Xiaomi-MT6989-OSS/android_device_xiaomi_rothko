# Charge
persist.vendor.accelerate.charge=true

# GPS
persist.sys.gps.enhance.ffae=true
#enable gps low power mode
persist.sys.gps.lowPowerMode=true

# SurfaceFlinger: map stock WorkDuration groups to the existing Lineage per-fps
# property format. Stock libsurfaceflinger.so uses high_fps for 90/120 Hz and
# 144_fps for 144 Hz; its legacy group property names have no A16 reader here.
# See configs/displayconfig/VSYNC_PROVENANCE.md for source and validation limits.
debug.sf.late.sf.duration.90=10300000
debug.sf.late.app.duration.90=11600000
debug.sf.early.sf.duration.90=10300000
debug.sf.early.app.duration.90=11600000
debug.sf.earlyGl.sf.duration.90=10300000
debug.sf.earlyGl.app.duration.90=11600000
debug.sf.late.sf.duration.120=10300000
debug.sf.late.app.duration.120=11600000
debug.sf.early.sf.duration.120=10300000
debug.sf.early.app.duration.120=11600000
debug.sf.earlyGl.sf.duration.120=10300000
debug.sf.earlyGl.app.duration.120=11600000
debug.sf.late.sf.duration.144=8900000
debug.sf.late.app.duration.144=10500000
debug.sf.early.sf.duration.144=8900000
debug.sf.early.app.duration.144=10500000
debug.sf.earlyGl.sf.duration.144=8900000
debug.sf.earlyGl.app.duration.144=10500000
ro.surface_flinger.enable_frame_rate_override=false

# NFC
ro.vendor.se.type=eSE,HCE,UICC
ro.vendor.se.chip.model=SN220T
ro.vendor.nfc.disable.i2c=false
ro.vendor.se.info=19-1010212
ro.vendor.nfc.repair=1
ro.vendor.nfc.dispatch_optim=2
ro.vendor.nfc.secure_display_optim=1
ro.vendor.nfc.selectcard=1
ro.vendor.nfc.aclog=1
ro.vendor.nfc.debounce_field_on=1
ro.vendor.nfc.field_on_debounce=500
ro.vendor.nfc.mibeam=1

# Stock Xiaomi THP touch
ro.vendor.touch.touchscheduler.enable=true
persist.vendor.touchfeature.gameturbotool.version=v3.5

# Stock panel-specific PQ configuration
ro.vendor.mtk.pq.odm=true

# Stock DSPP AIDL transport and render-intent callback branch.
ro.vendor.mtk.pq.aidl=true
