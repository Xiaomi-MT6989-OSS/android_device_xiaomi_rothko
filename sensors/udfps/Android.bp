cc_library_shared {
    name: "sensors.rothko.udfps",
    vendor: true,
    compile_multilib: "64",
    defaults: ["hidl_defaults"],
    srcs: ["UdfpsSubHal.cpp"],
    header_libs: ["android.hardware.sensors@2.X-multihal.header"],
    shared_libs: [
        "android.hardware.sensors@1.0",
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
}

cc_test_host {
    name: "rothko_fod_input_test",
    srcs: ["FodInputTest.cpp"],
    gtest: false,
}
