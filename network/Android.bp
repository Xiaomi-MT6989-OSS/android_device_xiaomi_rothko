// SPDX-License-Identifier: Apache-2.0
runtime_resource_overlay {
    name: "RothkoNetworkStackOverlay",
    product_specific: true,
}

genrule {
    name: "RothkoApnsConf",
    srcs: ["apns-conf.xml"],
    out: ["rothko-apns-conf.xml"],
    tools: ["xmllint"],
    cmd: "$(location xmllint) --nonet --noout $(in) && cp $(in) $(out)",
}
