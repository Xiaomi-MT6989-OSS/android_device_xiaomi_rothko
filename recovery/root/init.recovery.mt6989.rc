# The stock OS3.0.307.0 recovery uses this configfs controller.
# The generic recovery init script supplies the gadget and FunctionFS actions.
on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller 11201000.usb0
    # Match the Enable ADB menu before recovery starts adbd.
    setprop ro.adb.secure.recovery 0
