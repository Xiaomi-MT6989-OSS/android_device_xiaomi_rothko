cc_prebuilt_library_shared {
    name: "vendor.mediatek.hardware.camera.isphal-V1-ndk_rothko_camera_system",
    owner: "xiaomi",
    stem: "vendor.mediatek.hardware.camera.isphal-V1-ndk",
    srcs: [":vendor.mediatek.hardware.camera.isphal-V1-ndk_rothko_camera_system-stock"],
