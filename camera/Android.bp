        "libbinder",
        "libcamera_client",
        "libcamera_metadata",
        "libcutils",
        "libgui",
        "liblog",
        "libutils",
        "libvndksupport",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
}

cc_prebuilt_library_shared {
    name: "libcamera_mianode_jni.xiaomi_rothko_camera_system",
