// SPDX-License-Identifier: Apache-2.0
// Unmodified, originally signed rothko APK with its stock privileged identity.
vintf_fragment {
    name: "rothko-camera-bgservice.xml",
    src: "vendor.xiaomi.hardware.aidlbgservice-service.xml",
    vendor: true,
}

android_app_import {
    name: "MiuiCameraRothko",
    owner: "xiaomi",
    apk: ":MiuiCamera-rothko-stock",
    presigned: true,
    preprocessed: true,
    system_ext_specific: true,
    privileged: true,
    enforce_uses_libs: false,
    dex_preopt: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "rothko-camera-privapp-permissions",
    src: "privapp-permissions-rothko-camera.xml",
    filename: "privapp-permissions-rothko-camera.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "rothko-camera-hiddenapi",
    src: "hiddenapi-rothko-camera.xml",
    filename: "hiddenapi-rothko-camera.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}

// Original system-side ISP client closure; vendor counterparts stay isolated.
cc_prebuilt_library_shared {
    name: "libcamera_ispinterface_jni.xiaomi_rothko_camera_system",
    owner: "xiaomi",
    stem: "libcamera_ispinterface_jni.xiaomi",
    srcs: [":libcamera_ispinterface_jni.xiaomi_rothko_camera_system-stock"],
    system_ext_specific: true,
    compile_multilib: "64",
    strip: {
        none: true,
    },
    shared_libs: [
        "libandroid_runtime",
        "libbinder",
        "libcamera_client",
        "libcamera_metadata",
        "libcutils",
        "libgui",
        "libhidlbase",
        "libhidltransport_rothko",
        "liblog",
        "libmedia",
        "libnativehelper",
        "libui",
        "libutils",
        "libvndksupport",
        "vendor.mediatek.hardware.camera.isphal@1.0_rothko_camera_system",
        "vendor.mediatek.hardware.camera.isphal-V1-ndk_rothko_camera_system",
        "libbinder_ndk",
        "libmtkisp_metadata_sys_rothko_camera_system",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
}

cc_prebuilt_library_shared {
    name: "libcamera_algoup_jni.xiaomi_rothko_camera_system",
    owner: "xiaomi",
    stem: "libcamera_algoup_jni.xiaomi",
