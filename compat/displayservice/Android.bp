// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Keep the retired ABI local to rothko's API 34 camera consumers.
hidl_package_root {
    name: "android.frameworks.displayservice",
    use_current: true,
}

cc_binary {
    name: "android.frameworks.displayservice@1.0-service.rothko",
    system_ext_specific: true,
    relative_install_path: "hw",
    srcs: [
        "service.cpp",
        "DisplayService.cpp",
        "DisplayEventReceiver.cpp",
    ],
    local_include_dirs: ["include"],
    shared_libs: [
        "android.frameworks.displayservice@1.0",
        "libbase",
        "libgui",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    cflags: ["-Wall", "-Werror"],
    init_rc: ["displayservice.rc"],
    vintf_fragments: ["displayservice.xml"],
}
